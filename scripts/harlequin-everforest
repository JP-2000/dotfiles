#!/home/jitenpatel/.local/share/uv/tools/harlequin/bin/python
"""Launch Harlequin with an exact Everforest Dark Soft Textual theme."""

from __future__ import annotations

import os
import sys

from textual.theme import BUILTIN_THEMES, Theme


THEME_NAME = "everforest-soft"

# Official Everforest dark soft palette.
BG_DIM = "#293136"
BG0 = "#333C43"
BG1 = "#3A464C"
BG2 = "#434F55"
BG3 = "#4D5960"
BG4 = "#555F66"
BG5 = "#5D6B66"
BG_VISUAL = "#5C3F4F"
BG_RED = "#59464C"
BG_YELLOW = "#55544A"
BG_GREEN = "#48584E"
BG_BLUE = "#3F5865"
BG_PURPLE = "#4E4953"

FG = "#D3C6AA"
RED = "#E67E80"
ORANGE = "#E69875"
YELLOW = "#DBBC7F"
GREEN = "#A7C080"
AQUA = "#83C092"
BLUE = "#7FBBB3"
PURPLE = "#D699B6"
GREY0 = "#7A8478"
GREY1 = "#859289"
GREY2 = "#9DA9A0"


def register_everforest_theme() -> None:
    """Register Everforest Soft before Harlequin imports its theme list."""
    BUILTIN_THEMES[THEME_NAME] = Theme(
        name=THEME_NAME,
        primary=GREEN,
        secondary=AQUA,
        warning=YELLOW,
        error=RED,
        success=GREEN,
        accent=ORANGE,
        foreground=FG,
        background=BG0,
        surface=BG1,
        panel=BG2,
        dark=True,
        variables={
            "ansi-background": BG0,
            "ansi-foreground": FG,
            "block-cursor-background": GREEN,
            "block-cursor-foreground": BG0,
            "block-cursor-text-style": "none",
            "border": GREY1,
            "border-blurred": BG4,
            "button-color-foreground": BG0,
            "footer-background": BG1,
            "footer-description-foreground": FG,
            "footer-key-foreground": GREEN,
            "foreground-muted": GREY1,
            "input-cursor-background": GREEN,
            "input-cursor-foreground": BG0,
            "input-cursor-text-style": "none",
            "input-selection-background": f"{BG_VISUAL} 80%",
            "screen-selection-background": BG_VISUAL,
            "screen-selection-foreground": FG,
            "scrollbar": GREY1,
            "scrollbar-active": GREEN,
            "scrollbar-background": BG1,
            "scrollbar-background-active": BG2,
            "scrollbar-background-hover": BG2,
            "scrollbar-corner-color": BG1,
            "scrollbar-hover": GREY2,
        },
    )


def has_theme_argument(arguments: list[str]) -> bool:
    """Return True when the user already selected a Harlequin theme."""
    for argument in arguments:
        if argument == "-t":
            return True
        if argument == "--theme":
            return True
        if argument.startswith("--theme="):
            return True
    return False


def add_default_theme_argument() -> None:
    """Make this launcher use Everforest unless the user asks for another theme."""
    if has_theme_argument(sys.argv[1:]):
        return

    sys.argv[1:1] = ["--theme", THEME_NAME]


def main() -> None:
    os.environ.setdefault("COLORTERM", "truecolor")
    register_everforest_theme()
    add_default_theme_argument()

    from harlequin.cli import harlequin

    sys.exit(harlequin())


if __name__ == "__main__":
    main()
